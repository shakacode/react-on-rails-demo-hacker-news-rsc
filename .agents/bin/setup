#!/usr/bin/env bash
# Managed by shakacode/agent-workflows; this repo owns the command below.
set -euo pipefail
root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
cd "$root"
# `bin/setup` starts `bin/dev` unless this flag is present. Agent setup must
# finish instead of taking ownership of a development server.
exec bin/setup --skip-server "$@"
