#!/usr/bin/env bash
# Managed by shakacode/agent-workflows; this repo owns the command below.
set -euo pipefail
root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
cd "$root"

# Prepare the test database explicitly; `bin/rails test` does not guarantee a
# fresh checkout has run test-environment database setup first.
RAILS_ENV=test bin/rails db:prepare
exec env RAILS_ENV=test bin/rails test "$@"
